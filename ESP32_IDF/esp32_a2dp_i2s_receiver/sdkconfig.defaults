# Enable only the Bluetooth features required by an ESP32 Classic Bluetooth
# A2DP sink. These settings are based on Espressif's A2DP sink example.
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_BLE_ENABLED=n

# Keep both ESP32 cores available. The Bluetooth stack normally uses core 0
# and the I2S feeder task in this project is pinned to core 1.
CONFIG_FREERTOS_UNICORE=n

# A2DP/I2S diagnostics are printed once per second.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
